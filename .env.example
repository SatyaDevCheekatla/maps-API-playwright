# Google Maps API Automation Framework - Environment Variables Template
# Copy this file to .env and replace placeholder values with your environment details

# API Base URL (e.g. https://rahulshettyacademy.com)
BASE_URL=https://rahulshettyacademy.com

# API Authentication Key
MAPS_API_KEY=qaclick123

# Request Timeout in Milliseconds (e.g. 30000 = 30s)
API_TIMEOUT=30000

# Target Environment: development | qa | staging
ENVIRONMENT=development

# Logger Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Parallel Worker Count (recommended 2-4 depending on API rate limits)
WORKERS=2
