{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Add Place API Response",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["OK", "INVALID_REQUEST", "OVER_QUERY_LIMIT", "REQUEST_DENIED", "UNKNOWN_ERROR"]
    },
    "place_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["APP", "GOOGLE_APPS"]
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["status", "place_id", "scope", "reference", "id"],
  "additionalProperties": false
}
